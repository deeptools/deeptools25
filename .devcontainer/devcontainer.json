{
	"name": "DeepTools Benchmark",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"args": {
			"USERNAME": "${localEnv:USER}"
		}
	},
	"features": {
		"ghcr.io/devcontainers/features/rust:1": {
			"version": "latest",
			"profile": "default"
		}
	},
	"postCreateCommand": "chown -R ${localEnv:USER}:${localEnv:USER} /usr/local/cargo",
	"remoteUser": "${localEnv:USER}",
	"updateRemoteUserUID": true
}