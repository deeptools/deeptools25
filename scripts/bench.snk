PATHROOT="/data/manke/processing/salatino/deepdev/deeptools25/work-dir/testfiles"
NTIMES=2

rule all:
    input:
        expand("{PATHROOT}/output/new{implementation}.bg", implementation=(1,2), PATHROOT={PATHROOT}),
        expand("{PATHROOT}/output/benchmark_plot_{type}.png", type=["time", "mem"], PATHROOT={PATHROOT})


rule bamCoverage1:
    params:
        binsize = 1
    input:
        bam = "{PATHROOT}/S2_H2AZ.bam"
    output:
        bed = "{PATHROOT}/output/new1.bg"
    benchmark:
        repeat("{PATHROOT}/output/benchmark_bamCoverage1.txt", {NTIMES})
    threads: 1
    shell:
        """
        bamCoverage -b {input.bam} -o {output.bed} -of bedgraph -bs {params.binsize} -p {threads}
        """


rule bamCoverage2:
    params:
        binsize = 1
    input:
        bam = "{PATHROOT}/S2_H2AZ.bam"
    output:
        bed = "{PATHROOT}/output/new2.bg"
    benchmark:
        repeat("{PATHROOT}/output/benchmark_bamCoverage2.txt", {NTIMES})
    threads: 1
    shell:
        """
        bamCoverage2 -b {input.bam} -o {output.bed} -of bedgraph -bs {params.binsize} -p {threads}
        """


rule plot_benchmarks:
    input:
        benchmark1 = "{PATHROOT}/output/benchmark_bamCoverage1.txt",
        benchmark2 = "{PATHROOT}/output/benchmark_bamCoverage2.txt"
    output:
        time_plot = "{PATHROOT}/output/benchmark_plot_time.png",
        mem_plot = "{PATHROOT}/output/benchmark_plot_mem.png"
    params:
        outputtemplate = "{PATHROOT}/output/benchmark_plot.png"
    shell:
        """
        scripts/bench_plot.py {params.outputtemplate} {input.benchmark1} {input.benchmark2}
        """

