configfile: "bench.cfg"

BINSIZE = str(config["binsize"])

rule all:
    input:
        expand("{PATHROOT}/output/benchmark_bs" + BINSIZE + "_plot_{type}.png", type=["time", "mem"], PATHROOT=config["pathroot"])

rule bamCoverage:
    input:
        bam = "{PATHROOT}/S2_H2AZ.bam"
    output:
        bed = "{PATHROOT}/output/new{implementation}.bg"
    benchmark:
        repeat("{PATHROOT}/output/benchmark_bamCoverage{implementation}.txt", config["ntimes"])
    params:
        binsize = BINSIZE
    threads: config["threads"]
    shell:
        """
        mkdir -p $(dirname {output.bed})
        if [ "{wildcards.implementation}" = "1" ]; then
            bamCoverage -b {input.bam} -o {output.bed} -of bedgraph -bs {params.binsize} -p {threads}
        else
            bamCoverage2 -b {input.bam} -o {output.bed} -of bedgraph -bs {params.binsize} -p {threads}
        fi
        """

rule plot_benchmarks:
    input:
        new1 = "{PATHROOT}/output/new1.bg",
        new2 = "{PATHROOT}/output/new2.bg",
        benchmark1 = "{PATHROOT}/output/benchmark_bamCoverage1.txt",
        benchmark2 = "{PATHROOT}/output/benchmark_bamCoverage2.txt"
    output:
        time_plot = "{PATHROOT}/output/benchmark_bs" + BINSIZE + "_plot_time.png",
        mem_plot = "{PATHROOT}/output/benchmark_bs" + BINSIZE + "_plot_mem.png"
    params:
        outputtemplate = "{PATHROOT}/output/benchmark_bs" + BINSIZE + "_plot.png"
    shell:
        """
            scripts/bench_plot.py {params.outputtemplate} {input.benchmark1} {input.benchmark2}
        """
